# ── LiveKit Cloud (free "Build" tier — https://cloud.livekit.io) ─────────────
# Project settings → Keys. No credit card required.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Google AI Studio (free tier — https://aistudio.google.com/apikey) ────────
GOOGLE_API_KEY=your_google_ai_studio_key

# ── Optional overrides ────────────────────────────────────────────────────────
# Gemini Live model used for real-time voice (update if Google renames it):
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# Text model used to grade the interview and write the report:
# GEMINI_REPORT_MODEL=gemini-2.5-flash
# Interviewer voice (Puck, Charon, Kore, Fenrir, Aoede, ...):
# GEMINI_VOICE=Puck
